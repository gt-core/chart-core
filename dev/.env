VITE_EXTERNAL_USER_MANAGEMENT_BASE_URL=https://cug-identity.tradesea.ai/eum

# Trading APIs
VITE_TRADES_WRITE_BASE_URL=https://cug-trade-write.tradesea.ai/v1
VITE_TRADES_READ_BASE_URL=https://cug-trade-read.tradesea.ai/v1

# Market Data APIs
VITE_MARKET_DATA_BASE_URL=https://cug-market-data.tradesea.ai/v1
VITE_MARKET_DATA_WS_URL=wss://cug-market-data.tradesea.ai/v1/wss

# Discovery APIs
VITE_DISCOVERY_BASE_URL=https://cug-discovery.tradesea.ai

# Unified Stream WebSocket
VITE_UNIFIED_STREAM_WS_URL=wss://cug-trade-read.tradesea.ai/v1/users

